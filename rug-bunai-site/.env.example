# Supabase browser connection (safe to expose; do NOT use your service_role key here).
# Create a free project at https://supabase.com/dashboard, then open Project Settings > API.
# Paste the Project URL on line 5 and the publishable/anon key on line 6.
# Authentication, database, cart, wishlist, and product-photo storage all use these two values.
VITE_SUPABASE_URL=PASTE_YOUR_SUPABASE_PROJECT_URL_HERE
VITE_SUPABASE_ANON_KEY=PASTE_YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY_HERE
