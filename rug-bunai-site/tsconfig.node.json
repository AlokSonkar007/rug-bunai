{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // Contract test for the Supabase migration — kept out of the browser build
  // (tsconfig.app.json excludes it) and out of this Node project too; it is
  // type-checked implicitly when vitest runs it.
  "include": ["vite.config.ts"],
  "exclude": ["src/lib/siteContent.contract.test.ts"]
}
